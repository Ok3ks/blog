---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getAllSummaries } from '../../lib/posts';

const posts = await getAllSummaries();
---

<BaseLayout title="Blog" description="All posts.">
  <h1>Blog</h1>
  <p class="muted">{posts.length} post{posts.length === 1 ? '' : 's'}</p>

  <div class="post-grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>

  <style>
    .post-grid {
      display: grid;
      gap: 1.25rem;
      margin-top: 1.5rem;
    }
  </style>
</BaseLayout>
