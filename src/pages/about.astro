---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR, SOCIAL_LINKS } from '../consts';

// Open-source contributions, from the GitHub profile.
const contributions = [
  { label: 'opsdroid #2046', href: 'https://github.com/opsdroid/opsdroid/pull/2046' },
  { label: 'aiohttp #9745', href: 'https://github.com/aio-libs/aiohttp/pull/9745' },
  { label: 'aiohttp #9728', href: 'https://github.com/aio-libs/aiohttp/pull/9728' },
  { label: 'pymc #7854', href: 'https://github.com/pymc-devs/pymc/pull/7854' },
];
---

<BaseLayout title="About" description="About Emmanuel Okedele.">
  <h1>About</h1>
  <p>
    Hi 👋 I'm {AUTHOR}, a full-stack software engineer working on AI/ML research
    and applications. This blog is where I write up experiments, notes, and
    things I'm learning along the way — mostly around machine learning, NLP, and
    model evaluation.
  </p>

  <h2>Open-source contributions</h2>
  <ul>
    {
      contributions.map((c) => (
        <li>
          <a href={c.href} rel="noopener" target="_blank">
            {c.label}
          </a>
        </li>
      ))
    }
    <li>
      Co-contributor to
      <a href="https://github.com/HAKSOAT/acho" rel="noopener" target="_blank">
        Acho
      </a>
    </li>
  </ul>

  <p>
    You can find more of my work on
    {
      SOCIAL_LINKS.map((link) => (
        <a href={link.href} rel="me noopener" target="_blank">
          {link.label}
        </a>
      ))
    }.
  </p>
</BaseLayout>
