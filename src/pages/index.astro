---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TalkCard from '../components/TalkCard.astro';
import { getAllSummaries } from '../lib/posts';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR, SOCIAL_LINKS, TALKS } from '../consts';
import { youtubeId, toSeconds } from '../lib/youtube';

const posts = await getAllSummaries();

// Talks with a resolvable YouTube ID.
const talks = TALKS.flatMap((t) => {
  const id = youtubeId(t.video);
  if (!id) console.warn(`[talks] Could not parse YouTube video: "${t.video}"`);
  return id ? [{ ...t, id, start: toSeconds(t.start) }] : [];
});

// Posts and talks share one feed, newest first.
const TALK_SOURCE = 'Talks';
const items = [
  ...posts.map((post) => ({ kind: 'post' as const, date: post.pubDate, post })),
  ...talks.map((talk) => ({
    kind: 'talk' as const,
    date: new Date(talk.date ?? 0),
    talk,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

// Filter facets, derived from the items themselves.
const sources = Array.from(
  new Set(posts.map((p) => p.source ?? 'Blog'))
).sort();
if (talks.length > 0) sources.push(TALK_SOURCE);
const tags = Array.from(new Set(posts.flatMap((p) => p.tags))).sort();
// Past this many, tags start collapsed so they don't swamp the page.
const TAG_LIMIT = 6;

// Open-source contributions, from the GitHub profile.
const contributions = [
  { label: 'opsdroid #2046', href: 'https://github.com/opsdroid/opsdroid/pull/2046' },
  { label: 'aiohttp #9745', href: 'https://github.com/aio-libs/aiohttp/pull/9745' },
  { label: 'aiohttp #9728', href: 'https://github.com/aio-libs/aiohttp/pull/9728' },
  { label: 'pymc #7854', href: 'https://github.com/pymc-devs/pymc/pull/7854' },
];
---

<BaseLayout wide>
  <section class="hero">
    <div class="hero-main">
    <h1>{SITE_TITLE}</h1>
    <p class="lead muted">{SITE_DESCRIPTION}</p>
    <p>
      Hi 👋 I'm {AUTHOR}. This is where I write up experiments, notes, and
      things I'm learning — mostly around machine learning, NLP, and model
      evaluation.
    </p>

    <!-- One clearly dominant action, then secondary ones (Von Restorff Effect). -->
    <div class="hero-actions">
      {items.length > 0 && <a class="btn btn-primary" href="#posts">See my work</a>}
      {
        SOCIAL_LINKS.map((link) => {
          const isMail = link.href.startsWith('mailto:');
          return (
            <a
              class="btn"
              href={link.href}
              rel={isMail ? 'me' : 'me noopener'}
              target={isMail ? undefined : '_blank'}
            >
              {link.label}
            </a>
          );
        })
      }
    </div>
    </div>

    <!-- Chunked into a scannable list rather than one long sentence (Miller's Law). -->
    <div class="oss">
      <p class="oss-label">Open source</p>
      <ul class="oss-list">
        {
          contributions.map((c) => (
            <li>
              <a href={c.href} rel="noopener" target="_blank">{c.label}</a>
            </li>
          ))
        }
        <li>
          Co-contributor to
          <a href="https://github.com/HAKSOAT/acho" rel="noopener" target="_blank">Acho</a>
        </li>
      </ul>
    </div>
  </section>

  {
    items.length > 0 && (
      <section class="recent" id="posts">
        <h2>Writing &amp; Talks</h2>

        <!-- Controls grouped in one region (Common Region); only show choices
             that actually narrow things down (Hick's Law). -->
        <div class="filters" data-filters>
          <input
            type="search"
            class="filter-search"
            placeholder="Search titles…"
            aria-label="Search titles"
            data-search-input
          />

          {
            sources.length > 1 && (
              <div class="filter-group" role="group" aria-label="Filter by source">
                <button type="button" class="pill is-active" aria-pressed="true" data-source-filter="">
                  All
                </button>
                {sources.map((source) => (
                  <button type="button" class="pill" aria-pressed="false" data-source-filter={source}>
                    {source}
                  </button>
                ))}
              </div>
            )
          }

          {
            tags.length > 0 && (
              <details class="tag-filter" open={tags.length <= TAG_LIMIT}>
                <summary class="pill">Tags ({tags.length})</summary>
                <div class="filter-group" role="group" aria-label="Filter by tag">
                  {tags.map((tag) => (
                    <button type="button" class="pill" aria-pressed="false" data-tag-filter={tag}>
                      #{tag}
                    </button>
                  ))}
                </div>
              </details>
            )
          }

          <!-- Immediate feedback on every filter change (Doherty Threshold). -->
          <div class="filter-status">
            <button type="button" class="link-button" data-clear-filters hidden>
              Clear filters
            </button>
            <p class="muted small" data-result-count aria-live="polite">
              {items.length} {items.length === 1 ? 'item' : 'items'}
            </p>
          </div>
        </div>

        <div class="post-grid" data-post-grid>
          {
            items.map((item) =>
              item.kind === 'post' ? (
                <PostCard post={item.post} />
              ) : (
                <TalkCard
                  id={item.talk.id}
                  title={item.talk.title}
                  start={item.talk.start}
                  event={item.talk.event}
                  date={item.talk.date}
                  source={TALK_SOURCE}
                />
              )
            )
          }
        </div>
        <div class="no-results" data-no-results hidden>
          <p>Nothing matches your filters.</p>
          <button type="button" class="btn" data-clear-filters>Clear filters</button>
        </div>
      </section>
    )
  }

  <style>
    .hero {
      padding: 2rem 0 1rem;
    }
    /* Wide screens: intro on the left, open-source panel on the right. */
    @media (min-width: 960px) {
      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 19rem;
        gap: 3rem;
        align-items: center;
      }
      .hero-actions {
        margin-bottom: 0;
      }
      .oss {
        padding: 1rem 1.25rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
      }
      .oss-list {
        flex-direction: column;
        gap: 0.35rem;
      }
    }
    @media (max-width: 560px) {
      .hero {
        padding-top: 0.5rem;
      }
      /* Primary action on its own row, the rest sharing the next. */
      .hero-actions .btn {
        flex: 1;
        justify-content: center;
      }
      .hero-actions .btn-primary {
        flex-basis: 100%;
      }
    }
    /* Keep prose at a readable line length on wide screens. */
    .hero p {
      max-width: 44rem;
    }
    .hero h1 {
      font-size: clamp(2rem, 8vw, 2.75rem);
      letter-spacing: -0.03em;
      margin: 0;
    }
    .lead {
      font-size: 1.2rem;
      margin-top: 0.5rem;
    }
    .small {
      font-size: 0.9rem;
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin: 1.5rem 0 2rem;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding: 0 1.1rem;
      font: inherit;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--color-text);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      cursor: pointer;
      transition: border-color var(--transition), background var(--transition),
        color var(--transition);
    }
    .btn:hover {
      color: var(--color-text);
      border-color: var(--color-accent);
      text-decoration: none;
    }
    .btn-primary,
    .btn-primary:hover {
      color: var(--color-on-accent);
      background: var(--color-accent);
      border-color: var(--color-accent);
    }
    .btn-primary:hover {
      background: var(--color-accent-hover);
      border-color: var(--color-accent-hover);
    }
    .oss {
      font-size: 0.9rem;
    }
    .oss-label {
      margin: 0 0 0.35rem;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-text-muted);
    }
    .oss-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.25rem;
      padding: 0;
      margin: 0;
      list-style: none;
      color: var(--color-text-muted);
    }
    .recent h2 {
      margin-top: 2rem;
    }
    .post-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
      gap: 0.75rem;
      margin-top: 0.75rem;
    }
    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
      margin-top: 1rem;
      padding: 0.6rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
    }
    .filter-status {
      display: flex;
      align-items: center;
      gap: 1rem;
      min-height: 2.25rem;
      margin-left: auto;
      padding-inline: 0.4rem;
    }
    @media (max-width: 560px) {
      .filter-status {
        flex-basis: 100%;
        justify-content: space-between;
        flex-direction: row-reverse;
        margin-left: 0;
      }
    }
    .filter-status p {
      margin: 0;
    }
    .link-button {
      font: inherit;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--color-accent);
      background: none;
      border: 0;
      padding: 0.5rem 0;
      cursor: pointer;
    }
    .link-button:hover {
      text-decoration: underline;
    }
    .tag-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .tag-filter summary {
      list-style: none;
      display: inline-flex;
      align-items: center;
    }
    .tag-filter summary::-webkit-details-marker {
      display: none;
    }
    .tag-filter[open] summary {
      margin-bottom: 0.4rem;
    }
    .filter-search {
      flex: 0 1 22rem;
      min-width: 12rem;
      min-height: 2.5rem;
      padding: 0.5rem 0.75rem;
      font: inherit;
      color: var(--color-text);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
    }
    .filter-search:focus {
      outline: none;
      border-color: var(--color-accent);
    }
    .filter-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .pill {
      font: inherit;
      font-size: 0.85rem;
      cursor: pointer;
      color: var(--color-text-muted);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      min-height: 2.25rem;
      padding: 0.3rem 0.85rem;
      border-radius: 999px;
      transition: border-color var(--transition), color var(--transition),
        background var(--transition);
    }
    .pill:hover {
      border-color: var(--color-accent);
      color: var(--color-text);
    }
    .pill.is-active {
      color: var(--color-bg);
      background: var(--color-accent);
      border-color: var(--color-accent);
    }
    .no-results {
      margin-top: 1.25rem;
      padding: 2rem 1rem;
      text-align: center;
      color: var(--color-text-muted);
      border: 1px dashed var(--color-border);
      border-radius: var(--radius);
    }
    .no-results p {
      margin-bottom: 1rem;
    }
  </style>

  <script>
    const root = document.querySelector<HTMLElement>('[data-filters]');
    const grid = document.querySelector<HTMLElement>('[data-post-grid]');
    const noResults = document.querySelector<HTMLElement>('[data-no-results]');
    const resultCount = document.querySelector<HTMLElement>('[data-result-count]');
    const clearButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-clear-filters]')
    );
    const statusClear = document.querySelector<HTMLButtonElement>(
      '.filter-status [data-clear-filters]'
    );

    if (root && grid) {
      const searchInput = root.querySelector<HTMLInputElement>('[data-search-input]');
      const sourceButtons = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-source-filter]')
      );
      const tagButtons = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-tag-filter]')
      );
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-post]'));

      let source = '';
      const activeTags = new Set<string>();

      const apply = () => {
        const query = (searchInput?.value ?? '').trim().toLowerCase();
        let visible = 0;

        for (const card of cards) {
          const matchesSearch =
            !query || (card.dataset.search ?? '').includes(query);
          const matchesSource = !source || card.dataset.source === source;
          const cardTags = (card.dataset.tags ?? '')
            .split('|')
            .filter(Boolean);
          const matchesTags =
            activeTags.size === 0 ||
            [...activeTags].every((t) => cardTags.includes(t));

          const show = matchesSearch && matchesSource && matchesTags;
          card.hidden = !show;
          if (show) visible++;
        }

        const filtered = Boolean(query || source || activeTags.size);
        if (noResults) noResults.hidden = visible !== 0;
        if (statusClear) statusClear.hidden = !filtered || visible === 0;
        if (resultCount) {
          const noun = cards.length === 1 ? 'item' : 'items';
          resultCount.textContent = filtered
            ? `Showing ${visible} of ${cards.length} ${noun}`
            : `${cards.length} ${noun}`;
        }
      };

      const setPressed = (btn: HTMLButtonElement, on: boolean) => {
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', String(on));
      };

      searchInput?.addEventListener('input', apply);

      for (const btn of sourceButtons) {
        btn.addEventListener('click', () => {
          source = btn.dataset.sourceFilter ?? '';
          for (const b of sourceButtons) setPressed(b, b === btn);
          apply();
        });
      }

      for (const btn of tagButtons) {
        btn.addEventListener('click', () => {
          const tag = btn.dataset.tagFilter ?? '';
          if (activeTags.has(tag)) activeTags.delete(tag);
          else activeTags.add(tag);
          setPressed(btn, activeTags.has(tag));
          apply();
        });
      }

      // An easy way back from a dead end (Peak-End Rule).
      for (const btn of clearButtons) {
        btn.addEventListener('click', () => {
          if (searchInput) searchInput.value = '';
          source = '';
          activeTags.clear();
          for (const b of sourceButtons) setPressed(b, b.dataset.sourceFilter === '');
          for (const b of tagButtons) setPressed(b, false);
          apply();
          searchInput?.focus();
        });
      }
    }
  </script>
</BaseLayout>
