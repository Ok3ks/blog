---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getAllSummaries } from '../lib/posts';
import { SITE_TITLE, SITE_DESCRIPTION, AUTHOR, SOCIAL_LINKS } from '../consts';

const posts = await getAllSummaries();

// Filter facets, derived from the posts themselves.
const sources = Array.from(
  new Set(posts.map((p) => p.source ?? 'Blog'))
).sort();
const tags = Array.from(new Set(posts.flatMap((p) => p.tags))).sort();

// Open-source contributions, from the GitHub profile.
const contributions = [
  { label: 'opsdroid #2046', href: 'https://github.com/opsdroid/opsdroid/pull/2046' },
  { label: 'aiohttp #9745', href: 'https://github.com/aio-libs/aiohttp/pull/9745' },
  { label: 'aiohttp #9728', href: 'https://github.com/aio-libs/aiohttp/pull/9728' },
  { label: 'pymc #7854', href: 'https://github.com/pymc-devs/pymc/pull/7854' },
];
---

<BaseLayout>
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p class="lead muted">{SITE_DESCRIPTION}</p>
    <p>
      Hi 👋 I'm {AUTHOR}. This is where I write up experiments, notes, and
      things I'm learning — mostly around machine learning, NLP, and model
      evaluation.
    </p>
    <p class="muted small">
      Open-source contributions:
      {
        contributions.map((c, i) => (
          <>
            {i > 0 && ', '}
            <a href={c.href} rel="noopener" target="_blank">{c.label}</a>
          </>
        ))
      }, and co-contributor to
      <a href="https://github.com/HAKSOAT/acho" rel="noopener" target="_blank">Acho</a>.
    </p>
  </section>

  {
    posts.length > 0 && (
      <section class="recent">
        <h2>Posts</h2>

        <div class="filters" data-filters>
          <input
            type="search"
            class="filter-search"
            placeholder="Search titles…"
            aria-label="Search post titles"
            data-search-input
          />

          <div class="filter-group" role="group" aria-label="Filter by source">
            <button type="button" class="pill is-active" data-source-filter="">All</button>
            {
              sources.map((source) => (
                <button type="button" class="pill" data-source-filter={source}>
                  {source}
                </button>
              ))
            }
          </div>

          {
            tags.length > 0 && (
              <div class="filter-group" role="group" aria-label="Filter by tag">
                {tags.map((tag) => (
                  <button type="button" class="pill pill-tag" data-tag-filter={tag}>
                    #{tag}
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <div class="post-grid" data-post-grid>
          {posts.map((post) => <PostCard post={post} />)}
        </div>
        <p class="no-results" data-no-results hidden>No posts match your filters.</p>
      </section>
    )
  }

  <style>
    .hero {
      padding: 2rem 0 1rem;
    }
    .hero h1 {
      font-size: 2.75rem;
      letter-spacing: -0.03em;
      margin: 0;
    }
    .lead {
      font-size: 1.2rem;
      margin-top: 0.5rem;
    }
    .small {
      font-size: 0.9rem;
    }
    .recent h2 {
      margin-top: 2.5rem;
    }
    .post-grid {
      display: grid;
      gap: 1.25rem;
      margin-top: 1.25rem;
    }
    .filters {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
      margin-top: 1.25rem;
    }
    .filter-search {
      flex: 1 1 14rem;
      min-width: 12rem;
      padding: 0.5rem 0.75rem;
      font: inherit;
      color: var(--color-text);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
    }
    .filter-search:focus {
      outline: none;
      border-color: var(--color-accent);
    }
    .filter-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .pill {
      font: inherit;
      font-size: 0.85rem;
      cursor: pointer;
      color: var(--color-text-muted);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      transition: border-color var(--transition), color var(--transition),
        background var(--transition);
    }
    .pill:hover {
      border-color: var(--color-accent);
      color: var(--color-text);
    }
    .pill.is-active {
      color: var(--color-bg);
      background: var(--color-accent);
      border-color: var(--color-accent);
    }
    .no-results {
      margin-top: 1.25rem;
      color: var(--color-text-muted);
    }
  </style>

  <script>
    const root = document.querySelector<HTMLElement>('[data-filters]');
    const grid = document.querySelector<HTMLElement>('[data-post-grid]');
    const noResults = document.querySelector<HTMLElement>('[data-no-results]');

    if (root && grid) {
      const searchInput = root.querySelector<HTMLInputElement>('[data-search-input]');
      const sourceButtons = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-source-filter]')
      );
      const tagButtons = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-tag-filter]')
      );
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-post]'));

      let source = '';
      const activeTags = new Set<string>();

      const apply = () => {
        const query = (searchInput?.value ?? '').trim().toLowerCase();
        let visible = 0;

        for (const card of cards) {
          const matchesSearch =
            !query || (card.dataset.search ?? '').includes(query);
          const matchesSource = !source || card.dataset.source === source;
          const cardTags = (card.dataset.tags ?? '')
            .split('|')
            .filter(Boolean);
          const matchesTags =
            activeTags.size === 0 ||
            [...activeTags].every((t) => cardTags.includes(t));

          const show = matchesSearch && matchesSource && matchesTags;
          card.hidden = !show;
          if (show) visible++;
        }

        if (noResults) noResults.hidden = visible !== 0;
      };

      searchInput?.addEventListener('input', apply);

      for (const btn of sourceButtons) {
        btn.addEventListener('click', () => {
          source = btn.dataset.sourceFilter ?? '';
          for (const b of sourceButtons) b.classList.toggle('is-active', b === btn);
          apply();
        });
      }

      for (const btn of tagButtons) {
        btn.addEventListener('click', () => {
          const tag = btn.dataset.tagFilter ?? '';
          if (activeTags.has(tag)) activeTags.delete(tag);
          else activeTags.add(tag);
          btn.classList.toggle('is-active');
          apply();
        });
      }
    }
  </script>
</BaseLayout>
