---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getAllSummaries } from '../lib/posts';
import { withBase } from '../lib/url';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getAllSummaries()).slice(0, 5);
---

<BaseLayout>
  <section class="hero">
    <h1>{SITE_TITLE}</h1>
    <p class="lead muted">{SITE_DESCRIPTION}</p>
  </section>

  <section class="recent">
    <div class="section-head">
      <h2>Latest posts</h2>
      <a href={withBase('/blog')}>View all →</a>
    </div>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <style>
    .hero {
      padding: 2rem 0 1rem;
    }
    .hero h1 {
      font-size: 2.75rem;
      letter-spacing: -0.03em;
      margin: 0;
    }
    .lead {
      font-size: 1.2rem;
      margin-top: 0.5rem;
    }
    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 2rem;
    }
    .section-head h2 {
      margin: 0;
    }
    .post-grid {
      display: grid;
      gap: 1.25rem;
      margin-top: 1.25rem;
    }
  </style>
</BaseLayout>
