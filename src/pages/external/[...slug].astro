---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getExternalPosts, type ExternalPost } from '../../lib/externalPosts';
import { withBase } from '../../lib/url';

// One route per republished external post.
export async function getStaticPaths() {
  const posts = await getExternalPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = ExternalPost;

const post = Astro.props;
---

<BaseLayout title={post.title} description={post.description} canonical={post.link}>
  <article class="post">
    <header class="post-header">
      <a class="back-link" href={withBase('/#posts')}>← All writing</a>
      <p class="source-banner muted">
        Originally published on {post.source}.
        {post.link && <a href={post.link} rel="canonical">View the original →</a>}
      </p>
      <h1>{post.title}</h1>
      <p class="post-meta muted"><FormattedDate date={post.pubDate} /></p>
    </header>

    <!-- Full content from the source feed. -->
    <div class="post-body" set:html={post.contentHtml}></div>

    <footer class="post-footer">
      {
        post.link && (
          <a class="original-link" href={post.link} rel="canonical">
            Read this post on {post.source} →
          </a>
        )
      }
      <a class="back-link" href={withBase('/#posts')}>← Back to all writing</a>
    </footer>
  </article>

  <style>
    .post-header {
      margin-bottom: 2rem;
    }
    .source-banner {
      font-size: 0.9rem;
      padding: 0.6rem 0.9rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      margin: 0.75rem 0 1.5rem;
    }
    .post-header h1 {
      margin-top: 0;
      font-size: clamp(1.7rem, 6.5vw, 2.4rem);
      letter-spacing: -0.02em;
    }
    .post-meta {
      font-size: 0.95rem;
      margin: 0.5rem 0 0;
    }
    .post-body {
      font-size: 1.08rem;
      overflow-wrap: anywhere;
    }
    /* Feed HTML arrives with its own alignment and widgets; normalise it. */
    .post-body :global(*) {
      text-align: start !important;
    }
    .post-body :global(.subscription-widget-wrap-editor),
    .post-body :global(.button-wrapper),
    .post-body :global(.image-link-expand) {
      display: none;
    }
    /* Runs of one-line quotes read as a single block. */
    .post-body :global(blockquote + blockquote) {
      margin-top: -1.5rem;
    }
    .post-body :global(blockquote > p:last-child) {
      margin-bottom: 0;
    }
    /* Embedded charts and videos come with fixed pixel widths. */
    .post-body :global(iframe),
    .post-body :global(video),
    .post-body :global(table) {
      max-width: 100%;
    }
    .post-body :global(img) {
      border-radius: var(--radius);
      margin: 1.5rem 0;
    }
    .post-footer {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-border);
    }
    .post-footer {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
    .original-link {
      display: inline-flex;
      align-items: center;
      min-height: 2.5rem;
      font-weight: 600;
    }
  </style>
</BaseLayout>
