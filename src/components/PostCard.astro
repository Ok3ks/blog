---
import type { PostSummary } from '../lib/posts';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: PostSummary;
}

const { post } = Astro.props;
---

<article
  class="card"
  data-post
  data-source={post.source ?? 'Blog'}
  data-tags={post.tags.join('|')}
  data-search={post.title.toLowerCase()}
>
  <a class="card-link" href={post.url}>
    <h3 class="card-title">{post.title}</h3>
    <p class="card-meta muted">
      <FormattedDate date={post.pubDate} />
      {post.source && <> · {post.source}</>}
    </p>
    {post.description && <p class="card-desc">{post.description}</p>}
    {
      post.tags.length > 0 && (
        <p class="card-tags">
          {post.tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </p>
      )
    }
  </a>
</article>

<style>
  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    transition: border-color var(--transition), transform var(--transition),
      box-shadow var(--transition);
  }
  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1rem 1.15rem;
    color: inherit;
  }
  .card-link:hover {
    text-decoration: none;
  }
  .card-title {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }
  .card-meta {
    margin: 0.25rem 0 0.5rem;
    font-size: 0.8rem;
  }
  /* Two-line teaser keeps cards short and evenly sized. */
  .card-desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  /* Plain text, not pills: these aren't clickable, so they shouldn't look
     like the filter buttons above (Law of Similarity). */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: auto 0 0;
    padding-top: 0.5rem;
  }
  .tag {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
</style>
